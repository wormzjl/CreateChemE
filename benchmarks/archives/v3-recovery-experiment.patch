+        output.put("pressurePa", problem.input().topPressurePascal());
+        output.put("branch", problem.topology().condenserPhaseBranch());
+        output.put("coordinateCount", problem.degreeOfFreedomLedger().unknowns().size());
+        output.put("removedPoints", problem.truncationSupport().truncatedPointCount());
+        output.put("frozenSupport", support(problem));
+        output.put("seed", state(target.seed()));
+        output.put("savedEvidence", target.source().get("evidence"));
+        output.put("savedAudit", target.source().get("audit"));
+        output.put("accepted", false);
+        output.put("trace", trace.samples);
+        output.put("directionCallbacks", trace.directionEvents);
