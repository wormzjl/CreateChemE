+/** Attempt-boundary, monotone stage-support recovery. It prepares a seed, never accepts a column result. */
+final class V3StageSupportReactivation {
+    private static final double DEFECT_BUDGET_FACTOR = 8.0;
+
+    private V3StageSupportReactivation() {}
+
+    /**
+     * Reopens the largest incoming component defects until their remaining sum satisfies the existing 8*cutoff
+     * feed-fraction budget. Each chosen component is restored at every stage, using one existing material TDMA
+     * projection at the current temperatures; unrelated component profiles remain bit-for-bit unchanged.
+     *
+     * <p>Work is bounded by the input's node/component counts: at most one selection per component, one full
+     * property-ratio pass and one component-material solve. Property calls and outer loops checkpoint cancellation.
+     * A subsequent fresh simultaneous solve, convergence certificate and complete audit remain mandatory.</p>
+     */
+    static Result prepare(V3ColumnProblem source, V3DryMeshState state,
+                          V3ThermoModel thermo, V3SolveControl control) {
+        Objects.requireNonNull(source, "source");
+        Objects.requireNonNull(state, "state");
+        Objects.requireNonNull(thermo, "thermo");
+        Objects.requireNonNull(control, "control");
+        control.checkpoint();
+        V3TruncationSupport support = source.truncationSupport();
+        if (support.isIdentity() || support.cutoffMoleFraction() == 0.0) {
+            return new Unchanged("Stage support is already complete or disabled");
+        }
+        if (state.nodeCount() != source.topology().nodeCount()
+                || state.componentCount() != source.activeComponentBasis().componentCount()
+                || !source.input().componentBasis().equals(thermo.componentBasis())) {
+            throw new IllegalArgumentException("V3 support-reactivation state or thermodynamic basis differs");
+        }
+        double totalFeed = source.activeComponentBasis().totalFeedFlowMolPerSecond();
+        double reflux = source.input().specifications().stream()
+                .filter(V3ColumnSpecification.OrganicRefluxRatio.class::isInstance)
+                .map(V3ColumnSpecification.OrganicRefluxRatio.class::cast).findFirst().orElseThrow().ratio();
+        List<Incoming> incoming = new ArrayList<>(support.sinkEdges().size());
+        double[] componentDefects = new double[state.componentCount()];
+        double defectBefore = 0.0;
+        for (V3TruncationSupport.SinkEdge edge : support.sinkEdges()) {
+            control.checkpoint();
+            double flow = switch (edge.kind()) {
+                case VAPOR_TO_ABOVE -> state.vaporFlow(edge.sourceNode(), edge.component());
+                case LIQUID_TO_BELOW -> state.liquidFlow(edge.sourceNode(), edge.component());
+                case REFLUX_TO_TRAY_ONE -> reflux / (1.0 + reflux) * state.liquidFlow(edge.sourceNode(), edge.component());
+            };
+            double fraction = flow / totalFeed;
+            // Preserve the independent auditor's edge-by-edge feed-fraction summation order.
+            defectBefore += fraction;
+            componentDefects[edge.component()] += fraction;
+            incoming.add(new Incoming(edge.component(), fraction));
+        }
+        if (!Double.isFinite(defectBefore)) return new Unavailable("Stage support defect is outside the finite numerical range");
+        double limit = DEFECT_BUDGET_FACTOR * support.cutoffMoleFraction();
+        if (defectBefore <= limit) return new Unchanged("Stage support's summed incoming defect remains within its existing budget");
+
+        boolean[] selected = new boolean[state.componentCount()];
+        double remaining = defectBefore;
+        for (int selection = 0; selection < selected.length && remaining > limit; selection++) {
+            control.checkpoint();
+            int largest = -1;
+            for (int component = 0; component < selected.length; component++) {
+                if (!selected[component] && componentDefects[component] > 0.0
+                        && (largest < 0 || componentDefects[component] > componentDefects[largest])) largest = component;
+            }
+            if (largest < 0) return new Unavailable("No finite incoming component defect can be reactivated");
+            selected[largest] = true;
+            remaining = 0.0;
+            for (Incoming edge : incoming) if (!selected[edge.component()]) remaining += edge.feedFraction();
+        }
+        if (remaining > limit) return new Unavailable("Bounded component reactivation did not close its incoming-defect budget");
+        // The existing material projector needs a liquid total at the condenser; do not invent one for this branch.
+        if (!source.topology().hasLiquidPhase(source.topology().condenserNode())) {
+            return new Unavailable("A vapor-only condenser has no supported full-profile material projection; full retry is required");
+        }
