+        }
+        System.out.println("STAGNATION_REPLAY label=" + output.get("label") + " status=" + output.get("solverStatus")
+                + " accepted=" + output.get("accepted") + " regularized=" + trace.regularizedAccepted + "/"
+                + (trace.regularizedAccepted + trace.regularizedRejected));
+    }
