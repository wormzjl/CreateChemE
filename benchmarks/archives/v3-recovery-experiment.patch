+    private static List<Target> targets(List<String> names, Snapshot original, Snapshot truncated,
+            V3ColumnProblem full, double feedEnthalpy) {
+        V3ColumnProblem masked = null;
+        if (truncated != null) {
+            JsonObject captured = truncated.experiment("truncated-50-prefix-terminal");
+            validateCaptured(captured, feedEnthalpy);
+            V3DryMeshState projectedSeed = readState(captured.getAsJsonArray("seed"), full);
+            V3TruncationSupport frozen = V3TruncationSupport.derive(full, CUTOFF, projectedSeed);
+            if (frozen.truncatedPointCount() != captured.get("removedPoints").getAsInt()) {
+                throw new IllegalArgumentException("Saved truncated seed cannot reconstruct its reported fixed support");
+            }
+            masked = V3ColumnProblemResolver.withTruncation(full, frozen);
+            requireSupportPattern(masked, projectedSeed);
+            requireSupportPattern(masked, readState(captured.getAsJsonArray("terminalState"), masked));
+            requireSupportPattern(masked, readState(truncated.experiment("truncated-terminal-128")
+                    .getAsJsonArray("terminalState"), masked));
+        }
+        List<Target> targets = new ArrayList<>();
+        for (String name : names) {
+            String label = switch (name) {
+                case "predictor-seed" -> "production-55-predictor-12";
+                case "projected-seed" -> "production-55-projected-24";
+                case "predictor-terminal" -> "predictor-128";
+                case "truncated-seed" -> "truncated-50-prefix-terminal";
+                case "truncated-terminal" -> "truncated-terminal-128";
+                default -> throw new IllegalArgumentException("Unknown saved case " + name);
+            };
+            boolean isTruncated = name.startsWith("truncated-");
+            JsonObject source = (isTruncated ? truncated : original).experiment(label);
+            validateCaptured(source, feedEnthalpy);
+            String stateField = name.endsWith("-seed") ? "seed" : "terminalState";
+            V3ColumnProblem problem = isTruncated ? masked : full;
+            V3DryMeshState seed = readState(source.getAsJsonArray(stateField), problem);
+            requireSupportPattern(problem, seed);
+            targets.add(new Target(name, label, stateField, source, problem, seed, feedEnthalpy));
+        }
+        return List.copyOf(targets);
+    }
+
+    private static void validateCaptured(JsonObject source, double feedEnthalpy) {
+        if (finite(source.get("pressurePa")) != 55_000.0 || !"TWO_PHASE".equals(source.get("branch").getAsString())) {
+            throw new IllegalArgumentException("Snapshot is not the captured 55 kPa TWO_PHASE problem");
+        }
+        if (source.has("feedEnthalpy") && finite(source.get("feedEnthalpy")) != feedEnthalpy) {
+            throw new IllegalArgumentException("Saved feed enthalpies disagree");
+        }
+    }
+
+    private static void requireSupportPattern(V3ColumnProblem problem, V3DryMeshState state) {
+        for (int node = 0; node < state.nodeCount(); node++) {
+            for (int component = 0; component < state.componentCount(); component++) {
+                boolean retained = problem.truncationSupport().retains(node, component);
+                double liquid = state.liquidFlow(node, component), vapor = state.vaporFlow(node, component);
+                if (retained ? !(liquid > 0.0 && vapor > 0.0) : liquid != 0.0 || vapor != 0.0) {
+                    throw new IllegalArgumentException("Saved fixed-support pattern differs at node " + node + ", component " + component);
+                }
+            }
+        }
+    }
+
+    private static V3ColumnInput input(V3PengRobinsonThermo thermo) {
+        V3CrudeFeed crude = thermo.crudeFeed("createcheme:tia_juana_light");
+        double[] feed = crude.moleFractions();
+        double total = 2610.7 * 1000.0 / 3600.0;
+        for (int component = 0; component < feed.length; component++) feed[component] *= total;
+        return new V3ColumnInput(V3ColumnInput.SCHEMA_VERSION, crude.packageId(), crude.assayId(), crude.componentBasis(),
+                feed, 638.15, 30, 24, 55_000.0, 750.0, List.of(new V3ColumnSpecification.CondenserOutletTemperature(323.15),
+                new V3ColumnSpecification.OrganicRefluxRatio(2.0), new V3ColumnSpecification.ReboilerDuty(8_000_000.0)));
+    }
+
+    private static V3DryMeshState readState(JsonArray rows, V3ColumnProblem problem) {
+        int components = problem.activeComponentBasis().componentCount();
+        if (rows == null || rows.size() != problem.topology().nodeCount()) throw new IllegalArgumentException("Stored node count differs");
+        double[][] liquid = new double[rows.size()][components], vapor = new double[rows.size()][components];
+        double[] temperatures = new double[rows.size()];
+        for (int node = 0; node < rows.size(); node++) {
+            JsonArray row = rows.get(node).getAsJsonArray();
+            if (row.size() != 1 + 2 * components) throw new IllegalArgumentException("Stored active-component axis differs");
+            temperatures[node] = finite(row.get(0));
+            for (int component = 0; component < components; component++) {
+                liquid[node][component] = finite(row.get(1 + 2 * component));
+                vapor[node][component] = finite(row.get(2 + 2 * component));
+            }
+        }
+        return new V3DryMeshState(problem.topology(), components, liquid, vapor, temperatures);
+    }
+
+    private static List<List<Double>> state(V3DryMeshState state) {
+        List<List<Double>> rows = new ArrayList<>();
+        for (int node = 0; node < state.nodeCount(); node++) {
+            List<Double> row = new ArrayList<>();
+            row.add(state.temperatureKelvin(node));
+            for (int component = 0; component < state.componentCount(); component++) {
+                row.add(state.liquidFlow(node, component)); row.add(state.vaporFlow(node, component));
+            }
+            rows.add(row);
+        }
+        return rows;
+    }
+
+    private static List<String> activeIds(V3ColumnProblem problem) {
+        List<String> ids = new ArrayList<>();
+        for (int component = 0; component < problem.activeComponentBasis().componentCount(); component++) {
+            ids.add(problem.input().componentBasis().componentId(problem.activeComponentBasis().publicIndex(component)));
+        }
+        return List.copyOf(ids);
+    }
+
+    private static Map<String, Object> support(V3ColumnProblem problem) {
+        List<List<Boolean>> retained = new ArrayList<>();
+        for (int node = 0; node < problem.topology().nodeCount(); node++) {
+            List<Boolean> row = new ArrayList<>();
+            for (int component = 0; component < problem.activeComponentBasis().componentCount(); component++) {
+                row.add(problem.truncationSupport().retains(node, component));
+            }
+            retained.add(row);
+        }
+        return Map.of("cutoff", problem.truncationSupport().cutoffMoleFraction(), "retained", retained,
+                "reconstruction", problem.truncationSupport().isIdentity() ? "Exact OFF identity"
+                        : "Derived once from SAVED prepared seed, validated against reported count and saved seed/24/104 zero patterns");
+    }
+
+    private static Map<String, Object> residual(V3MeshResidual residual) {
+        Map<String, Double> maxima = new LinkedHashMap<>();
+        for (V3MeshResidual.Row row : residual.rows()) {
+            maxima.merge(row.equation().family().name(), Math.abs(row.scaledValue()), Math::max);
+        }
+        return Map.of("maximumScaledResidual", residual.maximumAbsoluteScaledResidual(), "familyMaxima", maxima,
+                "dominantRows", residual.rows().stream().sorted(Comparator.comparingDouble(
+                        (V3MeshResidual.Row row) -> Math.abs(row.scaledValue())).reversed()).limit(5).toList());
+    }
+
+    private static Map<String, Object> failure(Throwable failure) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("type", failure.getClass().getName()); result.put("message", failure.getMessage());
+        result.put("stack", java.util.Arrays.stream(failure.getStackTrace()).limit(12).map(Object::toString).toList());
+        return result;
+    }
+
+    private static double finite(JsonElement value) {
+        double number = value.getAsDouble();
+        if (!Double.isFinite(number)) throw new IllegalArgumentException("Saved numerical value is not finite");
+        return number;
+    }
+
+    private static String hash(byte[] bytes) {
+        try { return HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes)); }
+        catch (NoSuchAlgorithmException unavailable) { throw new IllegalStateException("SHA-256 unavailable", unavailable); }
+    }
+
+    private static Map<String, String> productionHashes() throws IOException {
+        Map<String, String> hashes = new LinkedHashMap<>();
+        try (var paths = Files.walk(Path.of("src/main/java/com/wormzjl/createcheme/science/column/v3"))) {
+            for (Path path : paths.filter(file -> file.toString().endsWith(".java")).sorted().toList()) {
+                hashes.put(path.toString(), hash(Files.readAllBytes(path)));
+            }
+        }
+        return hashes;
+    }
+
+    private static void save(Path path, Map<String, Object> report) throws IOException {
+        Files.writeString(path, JSON.toJson(report), StandardCharsets.UTF_8, StandardOpenOption.WRITE, StandardOpenOption.TRUNCATE_EXISTING);
+    }
+
+    private record Target(String name, String sourceExperiment, String stateField, JsonObject source,
+                          V3ColumnProblem problem, V3DryMeshState seed, double feedEnthalpy) {}
+
+    private record Snapshot(Path path, String sha256, Map<String, JsonObject> experiments) {
+        private static Snapshot load(Path path) throws IOException {
+            byte[] bytes = Files.readAllBytes(path);
+            JsonObject root = JsonParser.parseString(new String(bytes, StandardCharsets.UTF_8)).getAsJsonObject();
+            if (!"COMPLETE".equals(root.get("status").getAsString()) || !root.get("productionSourcesUnchanged").getAsBoolean()) {
+                throw new IllegalArgumentException("Historical snapshot is incomplete or source-unstable: " + path);
+            }
+            Map<String, JsonObject> experiments = new LinkedHashMap<>();
+            for (JsonElement element : root.getAsJsonArray("experiments")) {
+                JsonObject experiment = element.getAsJsonObject();
+                String label = experiment.get("label").getAsString();
+                if (experiments.putIfAbsent(label, experiment) != null) throw new IllegalArgumentException("Duplicate experiment " + label);
+            }
+            return new Snapshot(path, hash(bytes), Map.copyOf(experiments));
+        }
+        private JsonObject experiment(String name) {
+            JsonObject found = experiments.get(name);
+            if (found == null) throw new IllegalArgumentException("Missing saved experiment " + name);
+            return found;
+        }
+        private Map<String, String> description() { return Map.of("path", path.toString(), "sha256", sha256); }
+        private boolean unchanged() throws IOException { return sha256.equals(hash(Files.readAllBytes(path))); }
+    }
+
+    private record Options(Path input, Path truncatedInput, Path report, List<String> cases, List<Integer> budgets,
+                           double deadlineSeconds) {
+        private static Options parse(String[] args) {
+            Map<String, String> options = new LinkedHashMap<>();
+            Set<String> allowed = Set.of("--input", "--truncatedInput", "--report", "--cases", "--budgets", "--deadlineSeconds");
+            for (String arg : args) {
+                String[] pair = arg.split("=", 2);
+                if (pair.length != 2 || !allowed.contains(pair[0]) || pair[1].isBlank() || options.putIfAbsent(pair[0], pair[1]) != null) {
+                    throw new IllegalArgumentException("Invalid or duplicate argument " + arg);
+                }
+            }
+            if (!options.containsKey("--report")) throw new IllegalArgumentException("--report=NEW.json is required");
+            String selected = options.getOrDefault("--cases", "off");
+            List<String> cases = selected.equals("off") ? OFF_CASES : selected.equals("all") ? ALL_CASES : List.of(selected.split(",", -1));
+            if (cases.isEmpty() || !ALL_CASES.containsAll(cases) || new LinkedHashSet<>(cases).size() != cases.size()) {
+                throw new IllegalArgumentException("Invalid saved case selection " + selected);
+            }
+            List<Integer> budgets = new ArrayList<>();
+            for (String text : options.getOrDefault("--budgets", "12,24,128").split(",", -1)) {
+                int budget = Integer.parseInt(text);
+                if (budget < 1 || budget > 128 || budgets.contains(budget)) throw new IllegalArgumentException("Invalid iteration budget " + text);
+                budgets.add(budget);
+            }
+            double seconds = Double.parseDouble(options.getOrDefault("--deadlineSeconds", "120"));
+            if (!Double.isFinite(seconds) || seconds <= 0.0 || seconds > 600.0) throw new IllegalArgumentException("Deadline must be in (0,600]");
+            return new Options(Path.of(options.getOrDefault("--input", DEFAULT_INPUT.toString())).toAbsolutePath().normalize(),
+                    Path.of(options.getOrDefault("--truncatedInput", DEFAULT_TRUNCATED_INPUT.toString())).toAbsolutePath().normalize(),
+                    Path.of(options.get("--report")).toAbsolutePath().normalize(), List.copyOf(cases), List.copyOf(budgets), seconds);
+        }
+    }
+
+    private static final class Deadline implements V3SolveControl {
+        private final long started = System.nanoTime();
+        private final long budgetNanos;
+        private long checkpoints;
+        private Deadline(double seconds) { budgetNanos = (long) (seconds * 1_000_000_000.0); }
+        @Override public void checkpoint() {
+            checkpoints++;
+            if (Thread.currentThread().isInterrupted()) throw new CancellationException("Replay thread interrupted");
+            if (System.nanoTime() - started >= budgetNanos) throw new AttemptTimeout();
+        }
+    }
+
+    private static final class AttemptTimeout extends CancellationException {
+        private static final long serialVersionUID = 1L;
+        private AttemptTimeout() { super("Saved-state replay attempt deadline exceeded"); }
+    }
+
+    private static final class Trace implements V3NewtonTrace {
+        private final String label;
+        private final V3ColumnProblem problem;
+        private final List<Map<String, Object>> samples = new ArrayList<>();
+        private final List<Map<String, Object>> directionEvents = new ArrayList<>();
+        private int localAccepted, localRejected, fresh, reused, regularizedAccepted, regularizedRejected;
+        private int droppedSamples, droppedDirections;
+        private V3DryMeshState latest;
+        private Map<String, Object> latestSample;
+        private Trace(String label, V3ColumnProblem problem) { this.label = label; this.problem = problem; }
+        @Override public void sampledIteration(int iteration, V3MeshResidual residual, double merit) {}
+        @Override public void sampledState(int iteration, V3DryMeshState state, V3MeshResidual residual, double merit) {
+            Map<String, Object> sample = new LinkedHashMap<>(residual(residual));
+            sample.put("iteration", iteration);
+            sample.put("merit", Double.isFinite(merit) ? merit : Double.toString(merit));
+            sample.put("directionsBeforeSample", counts());
+            double nonPc12 = 0.0;
+            for (V3MeshResidual.Row row : residual.rows()) {
+                int component = row.equation().component();
+                if (component < 0 || !problem.input().componentBasis().componentId(
+                        problem.activeComponentBasis().publicIndex(component)).equals("PC12")) {
+                    nonPc12 = Math.max(nonPc12, Math.abs(row.scaledValue()));
+                }
+            }
+            sample.put("nonPc12Maximum", nonPc12);
+            latest = state; latestSample = sample;
+            if (samples.size() < MAXIMUM_TRACE_SAMPLES) samples.add(sample); else droppedSamples++;
+            if (iteration % 20 == 0) System.out.println(label + " iteration=" + iteration
+                    + " residual=" + residual.maximumAbsoluteScaledResidual());
+        }
+        @Override public void localBlockDirection(int iteration, boolean accepted) {
+            if (accepted) localAccepted++; else localRejected++;
+            direction(iteration, "local", accepted);
+        }
+        @Override public void finiteDifferenceJacobian(int iteration, boolean reuse) {
+            if (reuse) reused++; else fresh++;
+            direction(iteration, reuse ? "reusedFD" : "freshFD", null);
+        }
+        // Becomes the interface override when the coordinated production callback is installed.
+        public void regularizedDirection(int iteration, boolean accepted) {
+            if (accepted) regularizedAccepted++; else regularizedRejected++;
+            direction(iteration, "stagnationRegularized", accepted);
+        }
+        private void direction(int iteration, String kind, Boolean accepted) {
+            Map<String, Object> event = new LinkedHashMap<>();
+            event.put("iteration", iteration); event.put("kind", kind); event.put("accepted", accepted);
+            if (directionEvents.size() < MAXIMUM_TRACE_SAMPLES) directionEvents.add(event); else droppedDirections++;
+        }
+        private Map<String, Integer> counts() {
+            return Map.of("localAccepted", localAccepted, "localRejected", localRejected, "freshFD", fresh,
+                    "reusedFD", reused, "regularizedAccepted", regularizedAccepted, "regularizedRejected", regularizedRejected);
+        }
+    }
+}
