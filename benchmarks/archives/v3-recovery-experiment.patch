+package com.wormzjl.createcheme.science.column.v3;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+import com.wormzjl.createcheme.science.column.v3.linalg.V3BandedMatrix;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+
+class V3EquilibratedNormalEquationsTest {
+    @Test
+    void explicitRowNormalizationMatchesBitwiseAcrossNonuniformAndTruncatedLayouts() {
+        for (V3CondenserPhaseBranch branch : V3CondenserPhaseBranch.values()) {
+            V3ColumnProblem original = V3TruncationSupportTest.problem(branch, 0.0, 2);
+            V3ColumnProblem truncated = V3ColumnProblemResolver.withTruncation(
+                    original, V3TruncationSupportTest.topTailSupport(original));
+            for (V3ColumnProblem problem : List.of(original, truncated)) {
+                V3StageBlockLayout layout = new V3StageBlockLayout(problem);
+                V3FiniteDifferenceJacobian.Jacobian jacobian = jacobian(problem, stagePattern(layout));
+                V3MeshResidual residual = variedResidual(problem);
+                V3NormalEquations actual = V3NormalEquations.prepareRowEquilibrated(
+                        jacobian, residual, layout, V3SolveControl.UNBOUNDED);
+                V3NormalEquations expected = explicitNormalizedOracle(jacobian, residual, layout);
+
+                assertPreparedBits(expected, actual, 0.0);
+                double damping = 1.0e-8;
+                for (int trial = 0; trial < 8; trial++) {
+                    assertPreparedBits(expected, actual, damping);
+                    damping *= 10.0;
+                }
+            }
+        }
+    }
+
+    @Test
+    void widelyDifferentRowMagnitudesPreserveASimpleUndampedNewtonEquation() {
+        V3ColumnProblem problem = problem();
+        V3StageBlockLayout layout = new V3StageBlockLayout(problem);
+        double[][] values = zeros(layout);
+        double[] correction = new double[values.length];
+        List<V3MeshResidual.Row> rows = new ArrayList<>();
+        for (int row = 0; row < values.length; row++) {
+            double magnitude = Math.scalb(1.0, (row % 3 - 1) * 800);
+            values[row][row] = row % 2 == 0 ? magnitude : -magnitude;
+            correction[row] = (row % 5 - 2) * 0.25;
+            rows.add(row(problem, row, -values[row][row] * correction[row], 1.0));
+        }
+
+        V3NormalEquations prepared = V3NormalEquations.prepareRowEquilibrated(
+                jacobian(problem, values), new V3MeshResidual(rows), layout, V3SolveControl.UNBOUNDED);
+        V3BandedMatrix normal = prepared.dampedMatrix(0.0, V3SolveControl.UNBOUNDED);
+        double[] gradient = prepared.negativeGradient();
