+                    problem, evaluator, new V3DryMeshCoordinateMap(problem), target.seed(), thermo::newWorkspace,
+                    budget, V3ColumnCalculator.SCALED_RESIDUAL_TOLERANCE, control, trace);
+            output.put("solverStatus", attempt instanceof V3SimultaneousColumnSolver.Attempt.Failure failed
+                    ? failed.code() : "CONVERGED");
+            output.put("evidence", attempt.evidence());
+            output.put("terminalState", state(attempt.state()));
+            output.put("terminalResidual", residual(evaluator.evaluate(attempt.state(), thermo.newWorkspace())));
+            control.checkpoint();
+            V3AcceptanceAudit audit = new V3AcceptanceAuditor(problem, thermo, target.feedEnthalpy())
+                    .audit(attempt.state(), thermo.newWorkspace(), control);
