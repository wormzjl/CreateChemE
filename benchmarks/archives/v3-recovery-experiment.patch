+package com.wormzjl.createcheme.science.column.v3;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+class V3StagnationPolicyTest {
+    @Test
+    void smallStepAndPoorProgressAreBothRequired() {
+        assertTrue(V3SimultaneousColumnSolver.isStagnatingProgress(1.0 / 64.0, 1.0, 0.99));
+        assertTrue(V3SimultaneousColumnSolver.isStagnatingProgress(Math.scalb(1.0, -19), 1.0, 0.999999));
+        assertFalse(V3SimultaneousColumnSolver.isStagnatingProgress(1.0 / 32.0, 1.0, 0.999999));
+        assertFalse(V3SimultaneousColumnSolver.isStagnatingProgress(1.0 / 64.0, 1.0, 0.98));
+        assertFalse(V3SimultaneousColumnSolver.isStagnatingProgress(1.0, 1.0, 0.1));
+        assertFalse(V3SimultaneousColumnSolver.isStagnatingProgress(1.0 / 64.0, 0.0, 0.0));
+    }
+
+    @Test
+    void progressGateIsScaleIndependentAndNotAnAcceptanceTolerance() {
+        assertTrue(V3SimultaneousColumnSolver.isStagnatingProgress(1e-6, 1e-18, 0.999 * 1e-18));
+        assertTrue(V3SimultaneousColumnSolver.isStagnatingProgress(1e-6, 1e18, 0.999 * 1e18));
+        assertFalse(V3ConvergenceEvidence.unavailable().satisfiesGates());
+    }
+}
