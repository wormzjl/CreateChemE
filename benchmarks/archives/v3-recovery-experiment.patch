+
+    private static V3FiniteDifferenceJacobian.Jacobian jacobian(V3ColumnProblem problem, double[][] values) {
+        V3DegreeOfFreedomLedger ledger = problem.degreeOfFreedomLedger();
+        return new V3FiniteDifferenceJacobian.Jacobian(
+                ledger.equations().stream().map(V3DegreeOfFreedomLedger.Equation::id).toList(),
+                ledger.unknowns().stream().map(V3DegreeOfFreedomLedger.Unknown::id).toList(), values);
+    }
+
+    private static V3MeshResidual variedResidual(V3ColumnProblem problem) {
+        List<V3MeshResidual.Row> rows = new ArrayList<>();
+        for (int row = 0; row < problem.degreeOfFreedomLedger().equations().size(); row++) {
+            rows.add(row(problem, row, (row % 7 - 3) * 0.375 * Math.scalb(1.0, (row % 5 - 2) * 150),
+                    row % 3 + 1.0));
+        }
+        return new V3MeshResidual(rows);
+    }
+
+    private static List<V3MeshResidual.Row> zeroRows(V3ColumnProblem problem) {
+        List<V3MeshResidual.Row> rows = new ArrayList<>();
+        for (int row = 0; row < problem.degreeOfFreedomLedger().equations().size(); row++) {
+            rows.add(row(problem, row, 0.0, 1.0));
+        }
+        return rows;
+    }
+
+    private static V3MeshResidual.Row row(V3ColumnProblem problem, int row, double physical, double scale) {
+        return new V3MeshResidual.Row(problem.degreeOfFreedomLedger().equations().get(row).id(), physical, scale);
+    }
+
+    private static double[][] zeros(V3StageBlockLayout layout) {
+        int last = layout.nodeCount() - 1;
+        int size = layout.start(last) + layout.size(last);
+        return new double[size][size];
+    }
+
+    private static double[][] stagePattern(V3StageBlockLayout layout) {
+        double[][] values = zeros(layout);
+        for (int row = 0; row < values.length; row++) {
+            double magnitude = Math.scalb(1.0, (row % 5 - 2) * 150);
+            for (int column = 0; column < values.length; column++) {
+                if (Math.abs(nodeFor(row, layout) - nodeFor(column, layout)) <= 1) {
+                    values[row][column] = ((row * 11 + column * 7) % 9 - 4) * 0.25 * magnitude;
+                }
+            }
+            values[row][row] = (row % 2 == 0 ? 2.0 : -2.0) * magnitude;
+        }
+        values[0][1] = -0.0;
+        return values;
+    }
+
+    private static double[][] offBandPattern(V3StageBlockLayout layout, double scale, double noise) {
+        double[][] values = zeros(layout);
+        values[layout.start(4)][layout.start(3)] = 2.0;
+        values[layout.start(4)][layout.start(5) + layout.size(5) - 1] = 3.0;
+        values[0][layout.start(0) + layout.size(0) - 1] = scale;
+        values[0][layout.start(3)] = scale * noise;
+        return values;
+    }
+
+    private static int nodeFor(int index, V3StageBlockLayout layout) {
+        for (int node = 0; node < layout.nodeCount(); node++) {
+            if (index >= layout.start(node) && index < layout.start(node) + layout.size(node)) return node;
+        }
+        throw new AssertionError("Index outside test layout: " + index);
+    }
+
+    /** Builds the specified transformed system explicitly, then uses the unchanged normal-product implementation. */
+    private static V3NormalEquations explicitNormalizedOracle(V3FiniteDifferenceJacobian.Jacobian jacobian,
+            V3MeshResidual residual, V3StageBlockLayout layout) {
+        double[][] normalized = jacobian.values();
+        List<V3MeshResidual.Row> normalizedRows = new ArrayList<>();
+        for (int row = 0; row < normalized.length; row++) {
+            double maximum = 0.0;
+            for (double value : normalized[row]) maximum = Math.max(maximum, Math.abs(value));
+            if (maximum == 0.0) maximum = 1.0;
+            for (int column = 0; column < normalized[row].length; column++) normalized[row][column] /= maximum;
+            normalizedRows.add(new V3MeshResidual.Row(residual.rows().get(row).equation(),
+                    residual.rows().get(row).scaledValue() / maximum, 1.0));
+        }
+        return V3NormalEquations.prepare(new V3FiniteDifferenceJacobian.Jacobian(
+                jacobian.equations(), jacobian.unknowns(), normalized), new V3MeshResidual(normalizedRows),
+                layout, V3SolveControl.UNBOUNDED);
+    }
+
+    private static void assertPreparedBits(V3NormalEquations expected, V3NormalEquations actual, double damping) {
+        V3BandedMatrix expectedMatrix = expected.dampedMatrix(damping, V3SolveControl.UNBOUNDED);
+        V3BandedMatrix actualMatrix = actual.dampedMatrix(damping, V3SolveControl.UNBOUNDED);
+        assertEquals(expectedMatrix.size(), actualMatrix.size());
+        assertEquals(expectedMatrix.lowerBandwidth(), actualMatrix.lowerBandwidth());
+        assertEquals(expectedMatrix.upperBandwidth(), actualMatrix.upperBandwidth());
+        double[] expectedGradient = expected.negativeGradient();
+        double[] actualGradient = actual.negativeGradient();
+        assertEquals(expectedGradient.length, actualGradient.length);
+        for (int row = 0; row < expectedMatrix.size(); row++) {
+            assertBits(expectedGradient[row], actualGradient[row], "gradient " + row);
+            for (int column = 0; column < expectedMatrix.size(); column++) {
+                assertBits(expectedMatrix.get(row, column), actualMatrix.get(row, column),
+                        "matrix " + row + "/" + column + ", damping " + damping);
+            }
+        }
+    }
+
+    private static void assertBits(double expected, double actual, String detail) {
+        assertEquals(Double.doubleToRawLongBits(expected), Double.doubleToRawLongBits(actual), detail);
+    }
+}
