+        assertEquals(0.01, prepared.support().cutoffMoleFraction());
+        assertTrue(prepared.defectBefore() > 8.0 * prepared.support().cutoffMoleFraction());
+        assertEquals(0.0, prepared.defectAfter());
+        assertEquals(branch, prepared.problem().topology().condenserPhaseBranch());
