+        assertComponentMaterialClosure(second.problem(), second.seed(), 1);
+    }
+
+    @Test
+    void identityAndWithinBudgetSupportDoNotCallThermodynamicProperties() {
+        Fixture fixture = binary(V3CondenserPhaseBranch.TWO_PHASE);
+        V3ThermoModel noProperties = new ConstantThermo(fixture.problem().input().componentBasis(),
+                () -> { throw new AssertionError("No property call is needed"); });
+        V3ColumnProblem identity = V3ColumnProblemResolver.resolve(fixture.problem().input(), V3CondenserPhaseBranch.TWO_PHASE);
+        assertInstanceOf(V3StageSupportReactivation.Unchanged.class,
+                V3StageSupportReactivation.prepare(identity, fixture.state(), noProperties, V3SolveControl.UNBOUNDED));
+        double[][] liquid = V3ColumnInitializer.flows(fixture.state(), true);
+        double[][] vapor = V3ColumnInitializer.flows(fixture.state(), false);
+        vapor[2][0] = 1.0e-3;
+        V3DryMeshState withinBudget = new V3DryMeshState(fixture.problem().topology(), 2, liquid, vapor,
+                V3ColumnInitializer.temperatures(fixture.state()));
+
+        assertInstanceOf(V3StageSupportReactivation.Unchanged.class,
+                V3StageSupportReactivation.prepare(fixture.problem(), withinBudget, noProperties, V3SolveControl.UNBOUNDED));
+    }
+
+    @Test
+    void immutableSupportExpansionNeverRemovesExistingPointsOrAliasesItsSelection() {
+        Fixture fixture = binary(V3CondenserPhaseBranch.TWO_PHASE);
+        V3TruncationSupport before = fixture.problem().truncationSupport();
+        V3ColumnProblem original = V3ColumnProblemResolver.resolve(fixture.problem().input(), V3CondenserPhaseBranch.TWO_PHASE);
+        assertSame(before, before.reactivateComponents(original, new boolean[2], V3SolveControl.UNBOUNDED));
+        boolean[] selected = {true, false};
+
+        V3TruncationSupport after = before.reactivateComponents(original, selected, V3SolveControl.UNBOUNDED);
+        selected[0] = false;
+
+        for (int node = 0; node < fixture.state().nodeCount(); node++) {
+            for (int component = 0; component < 2; component++) {
+                if (before.retains(node, component)) assertTrue(after.retains(node, component));
+            }
+            assertTrue(after.retains(node, 0));
+        }
+        assertFalse(before.retains(0, 0));
+        assertEquals(before.cutoffMoleFraction(), after.cutoffMoleFraction());
+        assertThrows(IllegalArgumentException.class,
+                () -> before.reactivateComponents(original, new boolean[1], V3SolveControl.UNBOUNDED));
+    }
+
+    @Test
+    void unsupportedVaporOnlyProjectionRequestsFullRetryWithoutInventingALiquidSeed() {
+        Fixture fixture = binary(V3CondenserPhaseBranch.VAPOR_ONLY);
+
+        V3StageSupportReactivation.Unavailable unavailable = assertInstanceOf(V3StageSupportReactivation.Unavailable.class,
+                V3StageSupportReactivation.prepare(fixture.problem(), fixture.state(), fixture.thermo(), V3SolveControl.UNBOUNDED));
+
+        assertTrue(unavailable.detail().contains("vapor-only"));
+        assertFalse(fixture.problem().truncationSupport().retains(0, 0));
+        assertEquals(0.0, fixture.state().liquidFlow(0, 0));
+    }
+
+    @Test
+    void propertyFailureReturnsUnavailableAndDoesNotFallBackToFabricatedFlows() {
+        Fixture fixture = binary(V3CondenserPhaseBranch.TWO_PHASE);
+        V3ThermoModel failing = new ConstantThermo(fixture.problem().input().componentBasis(),
+                () -> { throw new V3ThermoException(V3ThermoException.Code.DOMAIN, null, "manufactured property failure"); });
+
+        V3StageSupportReactivation.Unavailable unavailable = assertInstanceOf(V3StageSupportReactivation.Unavailable.class,
+                V3StageSupportReactivation.prepare(fixture.problem(), fixture.state(), failing, V3SolveControl.UNBOUNDED));
+
+        assertTrue(unavailable.detail().contains("manufactured property failure"));
+        assertEquals(0.0, fixture.state().liquidFlow(0, 0));
+        assertEquals(0.0, fixture.state().vaporFlow(0, 0));
+    }
+
+    @Test
+    void cancellationDuringSelectionOrPropertyEvaluationEscapesUnchanged() {
+        Fixture fixture = binary(V3CondenserPhaseBranch.TWO_PHASE);
+        CancellationException cancelled = new CancellationException("cancel support reactivation");
+        AtomicInteger checkpoints = new AtomicInteger();
+        assertSame(cancelled, assertThrows(CancellationException.class,
+                () -> V3StageSupportReactivation.prepare(fixture.problem(), fixture.state(), fixture.thermo(),
+                        () -> { if (checkpoints.incrementAndGet() >= 3) throw cancelled; })));
+        V3ThermoModel cancelling = new ConstantThermo(fixture.problem().input().componentBasis(), () -> { throw cancelled; });
+        assertSame(cancelled, assertThrows(CancellationException.class,
+                () -> V3StageSupportReactivation.prepare(fixture.problem(), fixture.state(), cancelling, V3SolveControl.UNBOUNDED)));
+        assertFalse(fixture.problem().truncationSupport().retains(0, 0));
+        assertEquals(0.0, fixture.state().vaporFlow(0, 0));
+    }
+
+    private static Fixture binary(V3CondenserPhaseBranch branch) {
+        V3ColumnProblem original = V3TruncationSupportTest.problem(branch, branch == V3CondenserPhaseBranch.VAPOR_ONLY ? 0.0 : 1.0, 2);
+        V3TruncationSupport support = V3TruncationSupportTest.topTailSupport(original);
+        V3ColumnProblem problem = V3ColumnProblemResolver.withTruncation(original, support);
+        V3DryMeshState full = V3TruncationSupportTest.state(original,
+                V3TruncationSupportTest.uniformFlows(original), V3TruncationSupportTest.uniformFlows(original));
+        return new Fixture(problem, support.projectSeed(original, full), new ConstantThermo(original.input().componentBasis(), () -> {}));
+    }
+
+    private static Fixture twoLeakingComponents() {
+        V3ColumnInput input = new V3ColumnInput(V3ColumnInput.SCHEMA_VERSION, "test:reactivation", "test:ternary",
+                new V3ComponentBasis(List.of("first", "second", "bulk")), new double[] {1.0, 1.0, 100.0}, 400.0,
+                4, 2, 250_000.0, 750.0, List.of(new V3ColumnSpecification.CondenserOutletTemperature(400.0),
+                new V3ColumnSpecification.OrganicRefluxRatio(1.0), new V3ColumnSpecification.ReboilerDuty(0.0)));
+        V3ColumnProblem original = V3ColumnProblemResolver.resolve(input, V3CondenserPhaseBranch.TWO_PHASE);
+        double[][] liquid = new double[6][3], vapor = new double[6][3];
+        double[] temperatures = new double[6];
+        Arrays.fill(temperatures, 400.0);
+        for (int node = 0; node < 6; node++) {
+            liquid[node] = new double[] {node < 2 ? 1.0e-5 : 0.5, node < 2 ? 1.0e-5 : 0.5, 100.0};
+            vapor[node] = liquid[node].clone();
+        }
+        V3DryMeshState full = new V3DryMeshState(original.topology(), 3, liquid, vapor, temperatures);
+        V3TruncationSupport support = V3TruncationSupport.derive(original, 1.0e-3, full);
+        return new Fixture(V3ColumnProblemResolver.withTruncation(original, support), support.projectSeed(original, full),
+                new ConstantThermo(input.componentBasis(), () -> {}));
+    }
+
+    private static void assertComponentMaterialClosure(V3ColumnProblem problem, V3DryMeshState state, int component) {
+        double feed = problem.activeComponentBasis().feedFlowMolPerSecond(component);
+        double refluxRatio = problem.input().specifications().stream().filter(V3ColumnSpecification.OrganicRefluxRatio.class::isInstance)
+                .map(V3ColumnSpecification.OrganicRefluxRatio.class::cast).findFirst().orElseThrow().ratio();
+        for (int node = 0; node < state.nodeCount(); node++) {
+            double residual;
+            if (node == 0) {
+                residual = state.vaporFlow(1, component) - state.liquidFlow(0, component) - state.vaporFlow(0, component);
+            } else if (node == problem.topology().reboilerNode()) {
+                residual = state.liquidFlow(node - 1, component) - state.liquidFlow(node, component) - state.vaporFlow(node, component);
+            } else {
+                double liquidIn = node == 1 ? refluxRatio / (1.0 + refluxRatio) * state.liquidFlow(0, component)
+                        : state.liquidFlow(node - 1, component);
+                residual = liquidIn + state.vaporFlow(node + 1, component)
+                        + (node == problem.topology().feedTrayNumber() ? feed : 0.0)
+                        - state.liquidFlow(node, component) - state.vaporFlow(node, component);
+            }
+            assertEquals(0.0, residual, feed * 1.0e-10, "material row at node " + node);
+        }
+    }
+
+    private static void assertStateFlows(double[][] liquid, double[][] vapor, V3DryMeshState state) {
+        for (int node = 0; node < state.nodeCount(); node++) {
+            assertArrayEquals(liquid[node], V3ColumnInitializer.flows(state, true)[node]);
+            assertArrayEquals(vapor[node], V3ColumnInitializer.flows(state, false)[node]);
+        }
+    }
+
+    private record Fixture(V3ColumnProblem problem, V3DryMeshState state, V3ThermoModel thermo) {}
+
+    private record ConstantThermo(V3ComponentBasis componentBasis, Runnable onFugacity) implements V3ThermoModel {
+        @Override public V3ThermoWorkspace newWorkspace() { return new V3ThermoWorkspace(componentBasis.componentCount()); }
+        @Override public V3FugacityResult fugacity(double t, double p, double[] z, V3Phase phase, V3ThermoWorkspace workspace) {
+            onFugacity.run();
+            double[] logPhi = new double[componentBasis.componentCount()];
+            if (phase == V3Phase.LIQUID) {
+                logPhi[0] = Math.log(0.5);
+                if (logPhi.length > 1) logPhi[1] = Math.log(2.0);
+            }
+            return new V3FugacityResult(phase, logPhi, 1.0, 0.0, 1, 0.0);
+        }
+        @Override public double molarEnthalpy(double t, double p, double[] z, V3Phase phase, V3ThermoWorkspace workspace) { return 0.0; }
+        @Override public V3FlashResult flashTP(double t, double p, double[] z, V3ThermoWorkspace workspace) {
+            throw new AssertionError("Reactivation uses phase ratios and the authored material feed, not a new feed flash");
+        }
+    }
+}
