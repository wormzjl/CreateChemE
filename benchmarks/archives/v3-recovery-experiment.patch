+        try {
+            requireCompatibleState(source, state, control);
+            V3ColumnProblem original = V3ColumnProblemResolver.resolve(source.input(), source.topology().condenserPhaseBranch());
+            V3TruncationSupport expanded = support.reactivateComponents(original, selected, control);
+            V3ThermoModel checkpointedThermo = new CheckpointThermo(thermo, control);
+            double[][] projectedLiquid = V3ColumnInitializer.flows(state, true);
+            double[][] projectedVapor = V3ColumnInitializer.flows(state, false);
+            double[] temperatures = V3ColumnInitializer.temperatures(state);
+            control.checkpoint();
+            double[][] equilibriumRatios = V3ColumnInitializer.phaseRatios(original, checkpointedThermo,
+                    checkpointedThermo.newWorkspace(), projectedLiquid, projectedVapor, temperatures);
+            control.checkpoint();
+            // This existing O(nodes*components) TDMA restores positive flows from the authored feed, not a floor.
+            V3ColumnInitializer.solveMaterialBalances(original, equilibriumRatios, projectedLiquid, projectedVapor);
+            control.checkpoint();
+            double[][] liquid = V3ColumnInitializer.flows(state, true);
+            double[][] vapor = V3ColumnInitializer.flows(state, false);
+            for (int node = 0; node < state.nodeCount(); node++) {
+                control.checkpoint();
+                for (int component = 0; component < selected.length; component++) {
+                    if (!selected[component]) continue;
+                    liquid[node][component] = projectedLiquid[node][component];
+                    vapor[node][component] = projectedVapor[node][component];
+                }
+            }
+            V3ColumnProblem target = V3ColumnProblemResolver.withTruncation(original, expanded);
+            V3DryMeshState seed = new V3DryMeshState(target.topology(), state.componentCount(), liquid, vapor, temperatures);
+            requireCompatibleState(target, seed, control);
+            double defectAfter = defectFraction(expanded, source, seed, totalFeed, reflux, control);
+            if (!Double.isFinite(defectAfter) || defectAfter > limit) {
+                return new Unavailable("Reactivated seed still exceeds the unchanged summed stage-defect budget");
+            }
+            control.checkpoint();
+            int reopened = support.truncatedPointCount() - expanded.truncatedPointCount();
+            return new Prepared(target, expanded, seed, reopened, expanded.isIdentity(), defectBefore, defectAfter,
+                    "Reactivated " + reopened + " stage points with full material-balanced component profiles; fresh solve and audit required");
+        } catch (CancellationException cancelled) {
+            throw cancelled;
+        } catch (V3ThermoException | IllegalArgumentException unavailable) {
+            return new Unavailable(bounded("Stage support reactivation unavailable: " + unavailable.getMessage()));
+        }
+    }
+
+    private static double defectFraction(V3TruncationSupport support, V3ColumnProblem source, V3DryMeshState state,
+            double totalFeed, double reflux, V3SolveControl control) {
+        support.requireCompatible(source);
+        double result = 0.0;
+        for (V3TruncationSupport.SinkEdge edge : support.sinkEdges()) {
+            control.checkpoint();
+            double flow = switch (edge.kind()) {
+                case VAPOR_TO_ABOVE -> state.vaporFlow(edge.sourceNode(), edge.component());
+                case LIQUID_TO_BELOW -> state.liquidFlow(edge.sourceNode(), edge.component());
+                case REFLUX_TO_TRAY_ONE -> reflux / (1.0 + reflux) * state.liquidFlow(edge.sourceNode(), edge.component());
+            };
+            result += flow / totalFeed;
+        }
+        return result;
+    }
+
+    private static void requireCompatibleState(V3ColumnProblem problem, V3DryMeshState state, V3SolveControl control) {
+        for (int node = 0; node < state.nodeCount(); node++) {
+            control.checkpoint();
+            for (int component = 0; component < state.componentCount(); component++) {
+                boolean retained = problem.truncationSupport().retains(node, component);
+                double liquid = state.liquidFlow(node, component), vapor = state.vaporFlow(node, component);
+                boolean liquidPresent = retained && problem.condenserComponentPhases().hasLiquid(problem.topology(), node, component);
+                boolean vaporPresent = retained && problem.topology().hasVaporPhase(node);
+                if ((liquidPresent ? !(liquid > 0.0) : liquid != 0.0) || (vaporPresent ? !(vapor > 0.0) : vapor != 0.0)) {
+                    throw new IllegalArgumentException("Reactivation state violates its retained-flow or structural-phase support");
+                }
+            }
+        }
+    }
+
+    sealed interface Result permits Prepared, Unchanged, Unavailable {}
+
+    /** Defects are fractions of authored feed, not molar rates; fullSupportFallback means every point is now retained. */
+    record Prepared(V3ColumnProblem problem, V3TruncationSupport support, V3DryMeshState seed,
+                    int reopenedPoints, boolean fullSupportFallback, double defectBefore, double defectAfter,
+                    String detail) implements Result {
+        Prepared {
+            Objects.requireNonNull(problem, "problem"); Objects.requireNonNull(support, "support"); Objects.requireNonNull(seed, "seed");
+            support.requireCompatible(problem);
+            detail = requireDetail(detail);
+            if (support.cutoffMoleFraction() <= 0.0 || reopenedPoints <= 0 || reopenedPoints > support.totalPointCount()
+                    || fullSupportFallback != support.isIdentity() || !Double.isFinite(defectBefore) || !Double.isFinite(defectAfter)
+                    || defectBefore < 0.0 || defectAfter < 0.0 || defectAfter > DEFECT_BUDGET_FACTOR * support.cutoffMoleFraction()) {
+                throw new IllegalArgumentException("Invalid stage-support reactivation evidence");
+            }
+        }
+    }
+    record Unchanged(String detail) implements Result { Unchanged { detail = requireDetail(detail); } }
+    record Unavailable(String detail) implements Result { Unavailable { detail = requireDetail(detail); } }
+
+    private record Incoming(int component, double feedFraction) {}
+
+    /** Solve-confined forwarding adapter adds checkpoints without changing property arithmetic or workspace ownership. */
+    private record CheckpointThermo(V3ThermoModel delegate, V3SolveControl control) implements V3ThermoModel {
+        @Override public V3ComponentBasis componentBasis() { return delegate.componentBasis(); }
+        @Override public V3ThermoWorkspace newWorkspace() { control.checkpoint(); return delegate.newWorkspace(); }
+        @Override public V3FugacityResult fugacity(double t, double p, double[] z, V3Phase phase, V3ThermoWorkspace workspace) {
+            control.checkpoint();
+            V3FugacityResult result = delegate.fugacity(t, p, z, phase, workspace);
+            control.checkpoint();
+            return result;
+        }
+        @Override public double molarEnthalpy(double t, double p, double[] z, V3Phase phase, V3ThermoWorkspace workspace) {
+            control.checkpoint();
+            double result = delegate.molarEnthalpy(t, p, z, phase, workspace);
+            control.checkpoint();
+            return result;
+        }
+        @Override public V3FlashResult flashTP(double t, double p, double[] z, V3ThermoWorkspace workspace) {
+            control.checkpoint();
+            V3FlashResult result = delegate.flashTP(t, p, z, workspace);
+            control.checkpoint();
+            return result;
+        }
+    }
+
+    private static String bounded(String detail) { return detail.length() <= 256 ? detail : detail.substring(0, 256); }
+    private static String requireDetail(String detail) {
+        Objects.requireNonNull(detail, "detail");
+        if (detail.isBlank() || detail.length() > 256) throw new IllegalArgumentException("Stage-support detail must be bounded and nonblank");
+        return detail;
+    }
+}
