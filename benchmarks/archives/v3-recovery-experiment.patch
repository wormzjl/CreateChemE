+        V3StageSupportReactivation.Prepared prepared = assertInstanceOf(V3StageSupportReactivation.Prepared.class,
+                V3StageSupportReactivation.prepare(fixture.problem(), fixture.state(), fixture.thermo(), V3SolveControl.UNBOUNDED));
+
+        assertEquals(2, prepared.reopenedPoints());
