+    @Test
+    void cancellationEscapesNormalizationDelegationAndFinalValidationByIdentity() {
+        V3ColumnProblem problem = problem();
+        V3StageBlockLayout layout = new V3StageBlockLayout(problem);
+        V3FiniteDifferenceJacobian.Jacobian jacobian = jacobian(problem, stagePattern(layout));
+        V3MeshResidual residual = variedResidual(problem);
+        AtomicInteger total = new AtomicInteger();
+        V3NormalEquations expected = V3NormalEquations.prepareRowEquilibrated(
+                jacobian, residual, layout, () -> total.incrementAndGet());
+        assertTrue(total.get() > jacobian.unknowns().size() + 2);
+
+        for (int stopAt : new int[]{1, 2, jacobian.unknowns().size() + 2, total.get() / 2, total.get()}) {
+            AtomicInteger calls = new AtomicInteger();
+            CancellationException cancelled = new CancellationException("row-equilibrated preparation cancelled");
+            assertSame(cancelled, assertThrows(CancellationException.class,
+                    () -> V3NormalEquations.prepareRowEquilibrated(jacobian, residual, layout, () -> {
+                        if (calls.incrementAndGet() == stopAt) throw cancelled;
+                    })));
+            assertEquals(stopAt, calls.get());
+            assertPreparedBits(expected, V3NormalEquations.prepareRowEquilibrated(
+                    jacobian, residual, layout, V3SolveControl.UNBOUNDED), 1.0e-8);
