+package com.wormzjl.createcheme.science.column.v3;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.wormzjl.createcheme.science.column.v3.thermo.V3PengRobinsonThermo;
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+
+@Timeout(60)
+class V3StagnationRecoveryTest {
+    @Test
+    void savedOversizedNewtonFailureConsidersRegularizationAndReducesTheOriginalResidual() throws Exception {
+        Fixture fixture = fixture();
+        var evaluator = new V3MeshResidualEvaluator(fixture.problem(), fixture.thermo(), fixture.feedEnthalpy());
+        assertEquals(0.15935656839103807,
+                evaluator.evaluate(fixture.state(), fixture.thermo().newWorkspace()).maximumAbsoluteScaledResidual(), 1e-12);
+        AtomicInteger accepted = new AtomicInteger();
+        double[] previousMerit = {Double.POSITIVE_INFINITY};
+        V3NewtonTrace trace = new V3NewtonTrace() {
+            @Override public void sampledIteration(int iteration, V3MeshResidual residual, double merit) {
+                assertTrue(merit <= previousMerit[0], "Every chosen trial must reduce the original, unweighted merit");
+                previousMerit[0] = merit;
+            }
+            @Override public void regularizedDirection(int iteration, boolean chosen) { if (chosen) accepted.incrementAndGet(); }
+        };
+        V3SimultaneousColumnSolver.Attempt attempt = solve(fixture, V3SolveControl.UNBOUNDED, trace);
+        assertTrue(accepted.get() > 0, "Saved tiny-step state must exercise the new path");
+        assertTrue(attempt.evidence().maximumScaledResidual() < 0.01, attempt::toString);
+        V3AcceptanceAudit audit = new V3AcceptanceAuditor(fixture.problem(), fixture.thermo(), fixture.feedEnthalpy())
+                .audit(attempt.state(), fixture.thermo().newWorkspace());
+        if (attempt instanceof V3SimultaneousColumnSolver.Attempt.Converged) {
+            assertTrue(attempt.evidence().convergenceEvidence().satisfiesGates());
+        }
+        if (!audit.accepted() || !attempt.evidence().convergenceEvidence().satisfiesGates()) {
+            assertThrows(IllegalArgumentException.class, () -> V3ColumnResult.accepted(fixture.problem(),
+                    new V3InputDigest("3".repeat(64)), audit, attempt.evidence().convergenceEvidence()));
+        }
+    }
+
+    @Test
+    void cancellationInsideTheNewNormalPreparationEscapesWithItsIdentity() throws Exception {
+        Fixture fixture = fixture();
+        // Cancellation is a subtype of IllegalStateException; even a matching numerical message must escape.
+        CancellationException expected = new CancellationException(V3NormalEquations.OFF_BAND_MESSAGE);
+        V3SolveControl control = () -> {
+            boolean preparing = StackWalker.getInstance().walk(frames -> frames.anyMatch(frame ->
+                    frame.getClassName().equals(V3NormalEquations.class.getName())
+                            && frame.getMethodName().equals("prepareRowEquilibrated")));
+            if (preparing) throw expected;
+        };
+        assertSame(expected, assertThrows(CancellationException.class, () -> solve(fixture, control, V3NewtonTrace.NONE)));
+    }
+
+    @Test
+    void aChosenRegularizedStepCannotCarryTheRejectedNewtonCertificate() throws Exception {
+        Fixture fixture = fixture();
+        AtomicInteger chosen = new AtomicInteger();
+        V3NewtonTrace trace = new V3NewtonTrace() {
+            @Override public void sampledIteration(int iteration, V3MeshResidual residual, double merit) {}
+            @Override public void regularizedDirection(int iteration, boolean selected) { if (selected) chosen.incrementAndGet(); }
+        };
+        var attempt = V3SimultaneousColumnSolver.solveWithOneLocalBlockPredictor(fixture.problem(),
+                new V3MeshResidualEvaluator(fixture.problem(), fixture.thermo(), fixture.feedEnthalpy()),
+                new V3DryMeshCoordinateMap(fixture.problem()), fixture.state(), fixture.thermo()::newWorkspace,
+                1, 1e-8, V3SolveControl.UNBOUNDED, trace);
+        assertEquals(1, chosen.get());
+        assertInstanceOf(V3SimultaneousColumnSolver.Attempt.Failure.class, attempt);
+        assertFalse(attempt.evidence().convergenceEvidence().hasFinalNewtonStep());
+        assertFalse(attempt.evidence().convergenceEvidence().satisfiesGates());
+    }
+
+    @Test
+    void cancellationFromTheRecoveryObserverCannotBeConvertedToNumericalFallback() throws Exception {
+        Fixture fixture = fixture();
+        CancellationException expected = new CancellationException("cancel recovery observation");
+        V3NewtonTrace trace = new V3NewtonTrace() {
+            @Override public void sampledIteration(int iteration, V3MeshResidual residual, double merit) {}
+            @Override public void regularizedDirection(int iteration, boolean accepted) { throw expected; }
+        };
+        assertSame(expected, assertThrows(CancellationException.class, () -> solve(fixture, V3SolveControl.UNBOUNDED, trace)));
+    }
+
+    private static V3SimultaneousColumnSolver.Attempt solve(Fixture fixture, V3SolveControl control, V3NewtonTrace trace) {
+        return V3SimultaneousColumnSolver.solveWithOneLocalBlockPredictor(fixture.problem(),
+                new V3MeshResidualEvaluator(fixture.problem(), fixture.thermo(), fixture.feedEnthalpy()),
+                new V3DryMeshCoordinateMap(fixture.problem()), fixture.state(), fixture.thermo()::newWorkspace,
+                12, 1e-8, control, trace);
+    }
+
+    private static Fixture fixture() throws Exception {
+        List<String> lines;
+        try (var stream = V3StagnationRecoveryTest.class.getResourceAsStream("/v3-55kpa-stagnation.txt")) {
+            assertNotNull(stream);
+            try (var reader = new BufferedReader(new InputStreamReader(stream, StandardCharsets.UTF_8))) {
+                lines = reader.lines().filter(line -> !line.startsWith("#") && !line.isBlank()).toList();
+            }
+        }
+        var thermo = V3PengRobinsonThermo.fromRegisteredPackage("createcheme:cdu17_tjl_acs2018");
+        var crude = thermo.crudeFeed("createcheme:tia_juana_light");
+        double[] feed = crude.moleFractions();
+        for (int i = 0; i < feed.length; i++) feed[i] *= 2610.7 * 1000.0 / 3600.0;
+        var input = new V3ColumnInput(V3ColumnInput.SCHEMA_VERSION, crude.packageId(), crude.assayId(),
+                crude.componentBasis(), feed, 638.15, 30, 24, 55000, 750, List.of(
+                new V3ColumnSpecification.CondenserOutletTemperature(323.15),
+                new V3ColumnSpecification.OrganicRefluxRatio(2),
+                new V3ColumnSpecification.ReboilerDuty(8e6)));
+        var problem = V3ColumnProblemResolver.resolve(input, V3CondenserPhaseBranch.TWO_PHASE);
+        int nodes = problem.topology().nodeCount(), components = problem.activeComponentBasis().componentCount();
+        double[][] liquid = new double[nodes][components], vapor = new double[nodes][components];
+        double[] temperature = new double[nodes];
+        for (int node = 0; node < nodes; node++) {
+            String[] row = lines.get(node + 1).split(",");
+            assertEquals(1 + 2 * components, row.length);
+            temperature[node] = Double.parseDouble(row[0]);
+            for (int component = 0; component < components; component++) {
+                liquid[node][component] = Double.parseDouble(row[1 + 2 * component]);
+                vapor[node][component] = Double.parseDouble(row[2 + 2 * component]);
+            }
+        }
+        return new Fixture(problem, new V3DryMeshState(problem.topology(), components, liquid, vapor, temperature),
+                thermo, Double.parseDouble(lines.getFirst()));
+    }
+
+    private record Fixture(V3ColumnProblem problem, V3DryMeshState state, V3PengRobinsonThermo thermo, double feedEnthalpy) {}
+}
