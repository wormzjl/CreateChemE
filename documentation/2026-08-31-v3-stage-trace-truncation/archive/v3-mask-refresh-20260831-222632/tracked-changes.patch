+            if (cause instanceof Error error) throw error;
+            throw new IllegalStateException("Unexpected checked failure from calculator diagnostic construction", cause);
+        } catch (ReflectiveOperationException inaccessible) {
+            throw new IllegalStateException("Could not construct calculator diagnostic type " + constructor.getDeclaringClass().getSimpleName(), inaccessible);
