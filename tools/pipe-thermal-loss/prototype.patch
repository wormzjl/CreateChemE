+package com.wormzjl.createcheme.science.fluid.network;
+
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class PipeHeatExchangeTest {
+    private static PipeHeatExchange sensible() {
+        return new PipeHeatExchange(new double[]{0, 400_000}, new double[]{300, 400});
+    }
+    @Test void agreesWithIndependentConstantCpSolutionAndEnergyBalance() {
+        var result = sensible().exchange(400_000, 2, 8000, 300);
+        assertEquals(300 + 100 / Math.E, result.outletTemperature(), 1e-12);
+        assertEquals(400_000 / Math.E, result.outletEnthalpy(), 1e-9);
+        assertEquals(2 * (400_000 - result.outletEnthalpy()), result.heatLossWatts(), 1e-8);
+    }
+    @Test void latentHeatIsRemovedAtConstantTemperatureBeforeLiquidCools() {
+        var curve = new PipeHeatExchange(new double[]{0, 400_000, 2_400_000, 2_600_000},
+                new double[]{300, 400, 400, 500});
+        var partial = curve.exchange(2_400_000, 1, 10_000, 300);
+        assertEquals(1_400_000, partial.outletEnthalpy(), 1e-8);
+        assertEquals(400, partial.outletTemperature());
+        var full = curve.exchange(2_400_000, 1, 24_000, 300);
+        assertEquals(400_000 / Math.E, full.outletEnthalpy(), 1e-8);
+        assertEquals(300 + 100 / Math.E, full.outletTemperature(), 1e-10);
+    }
+    @Test void heatingAndReversalPreserveSignedHeatAccounting() {
+        var forward = sensible().exchange(0, 2, 8000, 400);
+        var reverse = sensible().exchange(0, -2, 8000, 400);
+        assertEquals(forward, reverse);
+        assertEquals(400 - 100 / Math.E, forward.outletTemperature(), 1e-12);
+        assertTrue(forward.heatLossWatts() < 0);
+        assertEquals(-2 * forward.outletEnthalpy(), forward.heatLossWatts());
+    }
+    @Test void subdivisionAndEnergyReferenceDoNotChangeTheAnswer() {
+        var curve = new PipeHeatExchange(new double[]{0, 200_000, 300_000, 700_000},
+                new double[]{300, 350, 350, 500});
+        var whole = curve.exchange(700_000, .4, 600, 300);
+        var first = curve.exchange(700_000, .4, 200, 300);
+        var second = curve.exchange(first.outletEnthalpy(), .4, 400, 300);
+        assertEquals(whole.outletEnthalpy(), second.outletEnthalpy(), 1e-8);
+        assertEquals(whole.heatLossWatts(), first.heatLossWatts() + second.heatLossWatts(), 1e-8);
+        var shifted = new PipeHeatExchange(new double[]{-1e6, -800_000, -700_000, -300_000},
+                new double[]{300, 350, 350, 500}).exchange(-300_000, .4, 600, 300);
+        assertEquals(whole.heatLossWatts(), shifted.heatLossWatts(), 1e-8);
+    }
+    @Test void zeroFlowAndHugeExposureHaveBoundedPhysicalLimits() {
+        assertEquals(0, sensible().exchange(400_000, 0, 1000, 300).heatLossWatts());
+        assertEquals(400, sensible().exchange(400_000, 0, 1000, 300).outletTemperature());
+        assertEquals(400, sensible().exchange(400_000, 2, 0, 300).outletTemperature());
+        var slow = sensible().exchange(400_000, 1e-100, 1000, 300);
+        assertEquals(300, slow.outletTemperature());
+        assertEquals(4e-95, slow.heatLossWatts(), 1e-108);
+    }
+    @Test void malformedCurvesAreRefusedAndInputsAreOwned() {
+        assertThrows(IllegalArgumentException.class, () -> new PipeHeatExchange(new double[]{0, 0}, new double[]{300, 400}));
+        assertThrows(IllegalArgumentException.class, () -> new PipeHeatExchange(new double[]{0, 1}, new double[]{400, 300}));
+        assertThrows(IllegalArgumentException.class, () -> sensible().exchange(400_001, 1, 1, 300));
+        assertThrows(IllegalArgumentException.class, () -> sensible().exchange(0, 1, -1, 300));
+        double[] h = {0, 400_000}, t = {300, 400};
+        var curve = new PipeHeatExchange(h, t); h[1] = 0; t[1] = 0;
+        assertEquals(400, curve.temperatureAt(400_000));
+    }
+}
