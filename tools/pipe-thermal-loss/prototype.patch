+package com.wormzjl.createcheme.science.fluid.network;
+
+import java.util.Arrays;
+
+/**
+ * Experimental zero-holdup stream heat exchange against a prescribed ambient temperature.
+ * The immutable curve is built outside an inner network solve. Enthalpy is J/kg, temperature K,
+ * mass flow kg/s and conductance UA W/K. Equal-temperature knots represent latent heat.
+ * This kernel is not yet wired into world simulation or its energy ledger.
+ */
+public final class PipeHeatExchange {
+    private final double[] enthalpy;
+    private final double[] temperature;
+
+    public PipeHeatExchange(double[] enthalpy, double[] temperature) {
+        if (enthalpy.length < 2 || enthalpy.length != temperature.length)
+            throw new IllegalArgumentException("At least two matching thermodynamic knots required");
+        this.enthalpy = enthalpy.clone();
+        this.temperature = temperature.clone();
+        for (int i = 0; i < enthalpy.length; i++) {
+            if (!Double.isFinite(this.enthalpy[i]) || !Double.isFinite(this.temperature[i])
+                    || this.temperature[i] <= 0 || i > 0 && (this.enthalpy[i] <= this.enthalpy[i - 1]
+                    || this.temperature[i] < this.temperature[i - 1]))
+                throw new IllegalArgumentException("Curve must have increasing enthalpy and nondecreasing temperature");
+        }
+    }
+
+    /** Positive heatLossWatts means energy leaves the stream; reversing flow selects the donor externally. */
+    public record Exchange(double outletEnthalpy, double outletTemperature, double heatLossWatts) {}
+
+    public double temperatureAt(double h) {
+        int i = interval(h);
+        return temperature[i] + (h - enthalpy[i]) / (enthalpy[i + 1] - enthalpy[i])
+                * (temperature[i + 1] - temperature[i]);
+    }
+
+    /** Exact integration of dh/d(UA) = -(T(h)-ambient)/abs(flow) on each affine curve segment. */
+    public Exchange exchange(double inletEnthalpy, double massFlow, double conductance, double ambient) {
+        if (!Double.isFinite(massFlow) || !Double.isFinite(conductance) || conductance < 0
+                || !Double.isFinite(ambient) || ambient < temperature[0]
+                || ambient > temperature[temperature.length - 1])
+            throw new IllegalArgumentException("Invalid flow/conductance or ambient outside the curve");
+        double initialTemperature = temperatureAt(inletEnthalpy);
+        if (massFlow == 0 || conductance == 0 || initialTemperature == ambient)
+            return new Exchange(inletEnthalpy, initialTemperature, 0);
+        double mass = Math.abs(massFlow), h = inletEnthalpy, remaining = conductance;
+        boolean cooling = initialTemperature > ambient;
+        for (int steps = 0; steps <= enthalpy.length; steps++) {
+            int i = interval(h);
+            if (cooling && i > 0 && h == enthalpy[i]) i--;
+            double t = temperatureAt(h), difference = t - ambient;
+            if (difference == 0 || remaining == 0) break;
+            double slope = (temperature[i + 1] - temperature[i]) / (enthalpy[i + 1] - enthalpy[i]);
+            int next = cooling ? i : i + 1;
+            double boundaryDifference = temperature[next] - ambient;
+            double crossing = Double.POSITIVE_INFINITY;
+            if (cooling ? boundaryDifference > 0 : boundaryDifference < 0) {
+                crossing = slope == 0 ? mass * Math.abs(enthalpy[next] - h) / Math.abs(difference)
+                        : mass / slope * Math.log(difference / boundaryDifference);
+            }
+            if (remaining < crossing || !Double.isFinite(crossing)) {
+                double delta = slope == 0 ? -remaining / mass * difference
+                        : difference / slope * Math.expm1(-slope * (remaining / mass));
+                h += delta;
+                // Only bound roundoff at the representable endpoints, never clip a physical temperature.
+                h = Math.max(enthalpy[0], Math.min(enthalpy[enthalpy.length - 1], h));
+                return new Exchange(h, temperatureAt(h), mass * (inletEnthalpy - h));
+            }
+            h = enthalpy[next];
+            remaining -= crossing;
+        }
+        return new Exchange(h, temperatureAt(h), mass * (inletEnthalpy - h));
+    }
+
+    private int interval(double h) {
+        if (!Double.isFinite(h) || h < enthalpy[0] || h > enthalpy[enthalpy.length - 1])
+            throw new IllegalArgumentException("Enthalpy outside the curve");
+        int at = Arrays.binarySearch(enthalpy, h);
+        return Math.min(enthalpy.length - 2, at >= 0 ? at : -at - 2);
+    }
+}
