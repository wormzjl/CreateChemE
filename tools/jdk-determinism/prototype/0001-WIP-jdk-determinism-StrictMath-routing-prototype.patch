@@ -0,0 +1,75 @@
+package com.wormzjl.createcheme.science.fluid;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+import com.wormzjl.createcheme.science.math.DeterministicMath;
+import java.lang.management.ManagementFactory;
+import org.junit.jupiter.api.Test;
+
+/**
+ * {@link DeterministicMath#pow} (the allocation-free fdlibm transliteration) must be bitwise equal to
+ * {@code StrictMath.pow}, the specified fdlibm result, and allocate nothing. The long form of the comparison (1.5 billion
+ * inputs on five runtimes) is {@code tools/jdk-determinism/src/PowEquivalence.java}; this is the gate's short form.
+ */
+class DeterministicMathTest {
+    private static long state = 0x2026_0927L;
+
+    private static long next() {
+        long z = (state += 0x9E3779B97F4A7C15L);
+        z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9L;
+        z = (z ^ (z >>> 27)) * 0x94D049BB133111EBL;
+        return z ^ (z >>> 31);
+    }
+
+    private static double logUniform(int eLo, int eHi) {
+        int e = eLo + (int) Long.remainderUnsigned(next(), eHi - eLo + 1);
+        return Double.longBitsToDouble(((long) (e + 1023) << 52) | (next() >>> 12));
+    }
+
+    private static void assertSame(double x, double y) {
+        double a = DeterministicMath.pow(x, y), b = StrictMath.pow(x, y);
+        if (Double.doubleToRawLongBits(a) != Double.doubleToRawLongBits(b) && !(Double.isNaN(a) && Double.isNaN(b))) {
+            fail("pow(" + Double.toHexString(x) + ", " + Double.toHexString(y) + "): DeterministicMath "
+                    + Double.toHexString(a) + ", StrictMath " + Double.toHexString(b));
+        }
+    }
+
+    @Test void powIsBitwiseStrictMathOnSpecialValues() {
+        double[] values = {0.0, -0.0, 1.0, -1.0, 2.0, -2.0, 0.5, -0.5, 1.5, -1.5, 3.0, -3.0, 0.25, 1e-300, -1e-300,
+            Double.MIN_VALUE, -Double.MIN_VALUE, Double.MIN_NORMAL, Double.MAX_VALUE, -Double.MAX_VALUE,
+            Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, Double.NaN, Math.nextUp(1.0), Math.nextDown(1.0),
+            0x1p31, -0x1p31, 0x1p53, 0x1p64, -0x1p64, 1023.0, 1024.0, 1075.0, -1074.0, -1075.0, 10.0, 0.1};
+        for (double x : values) {
+            for (double y : values) {
+                assertSame(x, y);
+            }
+        }
+    }
+
+    @Test void powIsBitwiseStrictMathOnSampledInputs() {
+        for (int i = 0; i < 400_000; i++) {
+            assertSame(Double.longBitsToDouble(next()), Double.longBitsToDouble(next())); // every double class
+            assertSame(-logUniform(-30, 30), (double) (next() % 200) * ((next() & 1) == 0 ? 1.0 : 0.5)); // negative bases
+            assertSame(1.0 + ((next() >>> 11) * 0x1p-53 - 0.5) * 0x1p-18, logUniform(28, 70)); // near 1, huge y
+            assertSame(logUniform(-1, 1), (next() & 1) == 0 ? 1000 + (next() % 150) : -1000 - (next() % 150)); // o/uflow
+            assertSame(logUniform(-47, 24), ((next() >>> 11) * 0x1p-53 - 0.5) * 8); // thermodynamic ranges
+        }
+    }
+
+    @Test void powAllocatesNothing() {
+        var threads = (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
+        long thread = Thread.currentThread().threadId();
+        double sink = 0;
+        for (int i = 0; i < 20_000; i++) {
+            sink += DeterministicMath.pow(1.0 + i * 1e-3, 0.37); // warm up
+        }
+        long before = threads.getThreadAllocatedBytes(thread);
+        for (int i = 0; i < 200_000; i++) {
+            sink += DeterministicMath.pow(1.0 + i * 1e-3, 0.37);
+        }
+        long allocated = threads.getThreadAllocatedBytes(thread) - before;
+        assertTrue(sink > 0);
+        // StrictMath.pow on JDK 21 to 27 allocates 96 bytes per call (19 MB here); the port allocates none.
+        assertTrue(allocated < 64 * 1024, allocated + " bytes allocated by 200,000 pow calls");
+    }
+}
