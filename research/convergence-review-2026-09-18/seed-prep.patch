+     * bubble-point update exposed, so a learned seed can be projected onto its material rows without moving
+     * its temperatures. Not a production entry point.
+     */
+    static V3DryMeshState experimentalProjectMaterialBalances(
+            V3ColumnProblem problem, V3ThermoModel thermo, V3ThermoWorkspace workspace, V3DryMeshState state,
+            int sweeps, double damping, boolean updateTemperatures) {
+        return experimentalProjectMaterialBalances(problem, thermo, workspace, state, sweeps, damping,
+                updateTemperatures, false);
+    }
